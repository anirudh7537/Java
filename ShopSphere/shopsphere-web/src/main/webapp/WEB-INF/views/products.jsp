<%@ taglib prefix="shop" tagdir="/WEB-INF/tags" %>
<%@ include file="fragments/header.jsp" %>

<section class="container catalog-page"><div class="catalog-heading"><div><span class="eyebrow">THE SHOPSPHERE COLLECTION</span><h1>Find your next <em>favorite.</em></h1><p>Useful things, chosen with care.</p></div><span class="result-count"><c:out value="${products.size()}"/> pieces</span></div>
<form class="catalog-filters" action="<c:url value='/products'/>" method="get"><label class="filter-search">Search<input class="form-control" name="q" type="search" value="<c:out value='${param.q}'/>" placeholder="Name, brand, or detail"></label><label>Collection<select class="form-select" name="category"><option value="">All collections</option><c:forEach var="category" items="${categories}"><option value="${category.categoryId}" <c:if test="${param.category eq category.categoryId}">selected</c:if>><c:out value="${category.name}"/></option></c:forEach></select></label><label>Sort by<select class="form-select" name="sort"><option value="featured">Featured</option><option value="price-asc" <c:if test="${param.sort eq 'price-asc'}">selected</c:if>>Price: low to high</option><option value="price-desc" <c:if test="${param.sort eq 'price-desc'}">selected</c:if>>Price: high to low</option><option value="rating" <c:if test="${param.sort eq 'rating'}">selected</c:if>>Top rated</option><option value="name" <c:if test="${param.sort eq 'name'}">selected</c:if>>Name</option></select></label><button class="btn btn-filter" type="submit">Apply filters</button></form>
<c:choose><c:when test="${empty products}"><div class="empty-state"><span class="eyebrow">NO MATCHES JUST YET</span><h2>Try a different search.</h2><p>Adjust your filters or explore the full collection.</p><a class="btn btn-dark-pill" href="<c:url value='/products'/>">Clear filters</a></div></c:when><c:otherwise><div class="product-grid"><c:forEach var="product" items="${products}"><shop:productCard product="${product}" /></c:forEach></div></c:otherwise></c:choose></section>
<%@ include file="fragments/footer.jsp" %>
