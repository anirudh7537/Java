<%@ include file="fragments/header.jsp" %>
<section class="auth-section container"><div class="auth-aside"><span class="eyebrow">A BETTER KIND OF BROWSING</span><h1>Good taste<br>travels<br><em>with you.</em></h1><p>Create an account to keep your addresses, wishlist, and order updates together.</p></div><div class="form-panel"><span class="eyebrow">JOIN THE SPHERE</span><h2>Create account</h2><form action="<c:url value='/register'/>" method="post" class="stack-form"><label>Full name<input class="form-control" type="text" name="name" autocomplete="name" required maxlength="120"></label><label>Email address<input class="form-control" type="email" name="email" autocomplete="email" required maxlength="254"></label><label>Mobile number <span class="muted">(optional)</span><input class="form-control" type="tel" name="mobile" autocomplete="tel" maxlength="32"></label><label>Password<input class="form-control" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="128" required><small>Use at least 8 characters.</small></label><button class="btn btn-dark-pill w-100" type="submit">Create account</button></form><p class="form-foot">Already a member? <a href="<c:url value='/login'/>">Sign in</a></p></div></section>
