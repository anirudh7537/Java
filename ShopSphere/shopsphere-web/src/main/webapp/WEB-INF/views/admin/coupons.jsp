<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / PROMOTIONS</span><h1>Coupons</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><section class="form-panel-wide"><h2 class="h5">Create coupon</h2><form action="<c:url value='/admin/coupons'/>" method="post" class="management-form"><input type="hidden" name="action" value="save"><label>Code<input class="form-control" name="code" maxlength="50" required></label><label>Discount type<select class="form-select" name="discountType"><option value="PERCENTAGE">Percentage</option><option value="FIXED">Fixed amount</option></select></label><label>Discount value<input class="form-control" name="discountValue" type="number" min="0.01" step="0.01" required></label><label>Minimum order<input class="form-control" name="minimumOrder" type="number" min="0" step="0.01" value="0" required></label><label>Maximum discount<input class="form-control" name="maximumDiscount" type="number" min="0" step="0.01"></label><label>Expiry<input class="form-control" name="expiryDate" type="datetime-local" required></label><button class="btn btn-dark-pill" type="submit">Create coupon</button></form></section><div class="table-responsive"><table class="table data-table"><thead><tr><th>Code</th><th>Offer</th><th>Minimum</th><th>Expires</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="coupon" items="${coupons}"><tr><td><strong><c:out value="${coupon.code}"/></strong></td><td><c:out value="${coupon.discountValue}"/> <c:out value="${coupon.discountType}"/></td><td><fmt:formatNumber value="${coupon.minimumOrder}" type="currency" currencyCode="INR"/></td><td><c:out value="${coupon.expiryDate}"/></td><td><span class="status-badge"><c:out value="${coupon.active ? 'ACTIVE' : 'INACTIVE'}"/></span></td><td><a class="btn btn-link" href="<c:url value='/admin/coupon-form'><c:param name='id' value='${coupon.couponId}'/></c:url>">Edit</a><form action="<c:url value='/admin/coupons'/>" method="post"><input type="hidden" name="action" value="toggle"><input type="hidden" name="couponId" value="${coupon.couponId}"><input type="hidden" name="state" value="${coupon.active ? 'deactivate' : 'activate'}"><button class="btn btn-link" type="submit"><c:out value="${coupon.active ? 'Deactivate' : 'Activate'}"/></button></form></td></tr></c:forEach></tbody></table></div></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
