<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / ORGANIZATION</span><h1>Categories</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><section class="form-panel-wide"><h2 class="h5">Create category</h2><form action="<c:url value='/admin/categories'/>" method="post" class="management-form"><input type="hidden" name="action" value="save"><label>Name<input class="form-control" name="name" maxlength="100" required></label><label class="wide">Description<input class="form-control" name="description" maxlength="500"></label><button class="btn btn-dark-pill" type="submit">Add category</button></form></section><div class="table-responsive"><table class="table data-table"><thead><tr><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="category" items="${categories}"><tr><td><strong><c:out value="${category.name}"/></strong></td><td><c:out value="${category.description}"/></td><td><span class="status-badge"><c:out value="${category.active ? 'ACTIVE' : 'INACTIVE'}"/></span></td><td><a class="btn btn-link" href="<c:url value='/admin/category-form'><c:param name='id' value='${category.categoryId}'/></c:url>">Edit</a><form action="<c:url value='/admin/categories'/>" method="post"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="categoryId" value="${category.categoryId}"><button class="btn btn-link text-danger" type="submit">Deactivate</button></form></td></tr></c:forEach></tbody></table></div></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
