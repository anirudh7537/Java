<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / CATALOG</span><h1>Products & inventory</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><section class="form-panel-wide"><h2 class="h5">Add a product</h2><form action="<c:url value='/admin/products'/>" method="post" class="management-form"><input type="hidden" name="action" value="save"><label>Name<input class="form-control" name="name" maxlength="180" required></label><label>Brand<input class="form-control" name="brand" maxlength="120"></label><label>Category<select class="form-select" name="categoryId" required><c:forEach var="category" items="${categories}"><option value="${category.categoryId}"><c:out value="${category.name}"/></option></c:forEach></select></label><label>Price<input class="form-control" name="price" type="number" min="0" step="0.01" required></label><label>Discount %<input class="form-control" name="discount" type="number" min="0" max="100" step="0.01" value="0" required></label><label>Stock<input class="form-control" name="stock" type="number" min="0" value="0" required></label><label class="wide">Image URL<input class="form-control" name="imageUrl" type="url" maxlength="1000"></label><label class="wide">Description<textarea class="form-control" name="description"></textarea></label><label><input type="checkbox" name="active" checked> Active</label><button class="btn btn-dark-pill" type="submit">Create product</button></form></section><div class="table-responsive"><table class="table data-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody><c:forEach var="product" items="${products}"><tr><td><strong><c:out value="${product.name}"/></strong><small class="d-block muted"><c:out value="${product.brand}"/></small></td><td><c:out value="${product.categoryName}"/></td><td><fmt:formatNumber value="${product.price}" type="currency" currencyCode="INR"/></td><td><form action="<c:url value='/admin/products'/>" method="post" class="d-flex gap-1"><input type="hidden" name="action" value="stock"><input type="hidden" name="productId" value="${product.productId}"><input class="form-control" name="stock" type="number" min="0" value="${product.stock}" style="width:90px"><button class="btn btn-outline-dark btn-sm" type="submit">Set</button></form></td><td><a class="btn btn-link" href="<c:url value='/admin/product-form'><c:param name='id' value='${product.productId}'/></c:url>">Edit</a><form action="<c:url value='/admin/products'/>" method="post" data-confirm="Deactivate this product?"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="productId" value="${product.productId}"><button class="btn btn-link text-danger" type="submit">Deactivate</button></form></td></tr></c:forEach></tbody></table></div></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
