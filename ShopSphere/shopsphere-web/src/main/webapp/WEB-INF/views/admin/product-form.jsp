<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / CATALOG</span><h1>Edit product</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><section class="form-panel-wide"><form action="<c:url value='/admin/products'/>" method="post" class="management-form"><input type="hidden" name="action" value="save"><input type="hidden" name="productId" value="${editing.productId}"><label>Name<input class="form-control" name="name" value="<c:out value='${editing.name}'/>" maxlength="180" required></label><label>Brand<input class="form-control" name="brand" value="<c:out value='${editing.brand}'/>" maxlength="120"></label><label>Category<select class="form-select" name="categoryId" required><c:forEach var="category" items="${categories}"><option value="${category.categoryId}" <c:if test="${category.categoryId eq editing.categoryId}">selected</c:if>><c:out value="${category.name}"/></option></c:forEach></select></label><label>Price<input class="form-control" name="price" type="number" min="0" step="0.01" value="${editing.price}" required></label><label>Discount %<input class="form-control" name="discount" type="number" min="0" max="100" step="0.01" value="${editing.discount}" required></label><label>Stock<input class="form-control" name="stock" type="number" min="0" value="${editing.stock}" required></label><label class="wide">Image URL<input class="form-control" name="imageUrl" type="url" maxlength="1000" value="<c:out value='${editing.imageUrl}'/>"></label><label class="wide">Description<textarea class="form-control" name="description"><c:out value="${editing.description}"/></textarea></label><label><input type="checkbox" name="active" <c:if test="${editing.active}">checked</c:if>> Active</label><button class="btn btn-dark-pill" type="submit">Save changes</button><a class="btn btn-outline-pill" href="<c:url value='/admin/products'/>">Cancel</a></form></section></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
