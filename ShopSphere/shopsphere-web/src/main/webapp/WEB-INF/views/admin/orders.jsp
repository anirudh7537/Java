<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / FULFILLMENT</span><h1>Orders</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><div class="table-responsive"><table class="table data-table"><thead><tr><th>Order</th><th>Customer</th><th>Placed</th><th>Payment</th><th>Total</th><th>Update status</th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#<c:out value="${order.orderId}"/><details><summary class="text-link">Items</summary><c:forEach var="item" items="${order.items}"><div><c:out value="${item.quantity}"/> x <c:out value="${item.productName}"/></div></c:forEach></details></td><td><c:out value="${order.userId}"/></td><td><c:out value="${order.createdAt}"/></td><td><span class="status-badge"><c:out value="${order.paymentStatus}"/></span></td><td><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></td><td><form action="<c:url value='/admin/orders'/>" method="post" class="d-flex gap-1"><input type="hidden" name="orderId" value="${order.orderId}"><select class="form-select form-select-sm" name="status"><option>CONFIRMED</option><option>PROCESSING</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button class="btn btn-outline-dark btn-sm" type="submit">Save</button></form></td></tr></c:forEach></tbody></table></div></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
