<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / PROMOTIONS</span><h1>Edit coupon</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><section class="form-panel-wide"><form action="<c:url value='/admin/coupons'/>" method="post" class="management-form"><input type="hidden" name="action" value="save"><input type="hidden" name="couponId" value="${editing.couponId}"><label>Code<input class="form-control" name="code" value="<c:out value='${editing.code}'/>" maxlength="50" required></label><label>Discount type<select class="form-select" name="discountType"><option value="PERCENTAGE" <c:if test="${editing.discountType eq 'PERCENTAGE'}">selected</c:if>>Percentage</option><option value="FIXED" <c:if test="${editing.discountType eq 'FIXED'}">selected</c:if>>Fixed amount</option></select></label><label>Discount value<input class="form-control" name="discountValue" type="number" min="0.01" step="0.01" value="${editing.discountValue}" required></label><label>Minimum order<input class="form-control" name="minimumOrder" type="number" min="0" step="0.01" value="${editing.minimumOrder}" required></label><label>Maximum discount<input class="form-control" name="maximumDiscount" type="number" min="0" step="0.01" value="${editing.maximumDiscount}"></label><label>Expiry<input class="form-control" name="expiryDate" type="datetime-local" value="${editing.expiryDate}" required></label><button class="btn btn-dark-pill" type="submit">Save coupon</button><a class="btn btn-outline-pill" href="<c:url value='/admin/coupons'/>">Cancel</a></form></section></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
