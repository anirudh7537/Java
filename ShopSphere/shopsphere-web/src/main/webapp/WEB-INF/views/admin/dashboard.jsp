<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">SHOPSPHERE / ADMINISTRATION</span><h1>Store overview</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><div class="stat-grid"><article class="stat-card"><span>Orders placed</span><strong><c:out value="${summary.orders}"/></strong></article><article class="stat-card"><span>Customers</span><strong><c:out value="${summary.customers}"/></strong></article><article class="stat-card"><span>Recorded sales</span><strong><fmt:formatNumber value="${summary.sales}" type="currency" currencyCode="INR"/></strong></article><article class="stat-card"><span>Low-stock items</span><strong><c:out value="${summary.lowStock.size()}"/></strong></article></div><div class="management-toolbar"><h2 class="h5">Recent orders</h2><a class="text-link" href="<c:url value='/admin/orders'/>">Manage orders</a></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Order</th><th>Customer ID</th><th>Status</th><th>Payment</th><th>Total</th></tr></thead><tbody><c:forEach var="order" items="${summary.recentOrders}"><tr><td>#<c:out value="${order.orderId}"/></td><td><c:out value="${order.userId}"/></td><td><span class="status-badge"><c:out value="${order.orderStatus}"/></span></td><td><c:out value="${order.paymentStatus}"/></td><td><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></td></tr></c:forEach></tbody></table></div><div class="management-toolbar mt-4"><h2 class="h5">Low-stock products</h2><a class="text-link" href="<c:url value='/admin/products'/>">Manage inventory</a></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Product</th><th>Stock</th><th>Category</th></tr></thead><tbody><c:forEach var="product" items="${summary.lowStock}"><tr><td><c:out value="${product.name}"/></td><td><span class="stock-badge"><c:out value="${product.stock}"/></span></td><td><c:out value="${product.categoryName}"/></td></tr></c:forEach></tbody></table></div></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
