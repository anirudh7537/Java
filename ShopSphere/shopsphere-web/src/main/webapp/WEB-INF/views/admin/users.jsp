<%@ include file="../fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ADMIN / ACCOUNTS</span><h1>Customers</h1></div><div class="content-grid"><%@ include file="../fragments/sidebar.jsp" %><div class="admin-main"><div class="table-responsive"><table class="table data-table"><thead><tr><th>Customer</th><th>Email</th><th>Mobile</th><th>Joined</th><th>Account</th><th></th></tr></thead><tbody><c:forEach var="customer" items="${customers}"><tr><td><strong><c:out value="${customer.name}"/></strong></td><td><c:out value="${customer.email}"/></td><td><c:out value="${customer.mobile}" default="-"/></td><td><c:out value="${customer.createdAt}"/></td><td><span class="status-badge"><c:out value="${customer.active ? 'ACTIVE' : 'INACTIVE'}"/></span></td><td><form action="<c:url value='/admin/users'/>" method="post"><input type="hidden" name="userId" value="${customer.userId}"><button class="btn btn-link" type="submit" name="action" value="${customer.active ? 'deactivate' : 'activate'}"><c:out value="${customer.active ? 'Deactivate' : 'Activate'}"/></button></form></td></tr></c:forEach></tbody></table></div></div></div></section>
<%@ include file="../fragments/footer.jsp" %>
