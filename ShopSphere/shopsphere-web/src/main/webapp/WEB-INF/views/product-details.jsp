<%@ include file="fragments/header.jsp" %>
<section class="container detail-page"><div class="detail-image"><img src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>"><c:if test="${product.discount gt 0}"><span class="discount-pill"><fmt:formatNumber value="${product.discount}" maxFractionDigits="0"/>% off</span></c:if></div><div class="detail-copy"><span class="eyebrow"><c:out value="${product.categoryName}"/> / <c:out value="${product.brand}"/></span><h1><c:out value="${product.name}"/></h1><div class="detail-rating"><shop:rating score="${product.averageRating}"/><span><c:out value="${product.reviewCount}"/> reviews</span></div><div class="detail-price"><strong><fmt:formatNumber value="${product.salePrice}" type="currency" currencyCode="INR"/></strong><c:if test="${product.discount gt 0}"><del><fmt:formatNumber value="${product.price}" type="currency" currencyCode="INR"/></del></c:if></div><p class="detail-description"><c:out value="${product.description}"/></p><p class="stock-line"><span class="stock-dot ${product.stock lt 1 ? 'out' : ''}"></span><c:choose><c:when test="${product.stock gt 0}">In stock · <c:out value="${product.stock}"/> available</c:when><c:otherwise>Currently unavailable</c:otherwise></c:choose></p><div class="detail-actions"><form action="<c:url value='/cart'/>" method="post"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${product.productId}"><label class="visually-hidden" for="quantity">Quantity</label><input id="quantity" class="form-control quantity-input" type="number" name="quantity" min="1" max="${product.stock}" value="1" required><button class="btn btn-dark-pill" type="submit" <c:if test="${product.stock lt 1}">disabled</c:if>>Add to cart</button></form><form action="<c:url value='/wishlist'/>" method="post"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${product.productId}"><button class="btn btn-outline-pill" type="submit">Save item</button></form></div></div></section>
<section class="container reviews-section"><div class="section-heading"><div><span class="eyebrow">CUSTOMER NOTES</span><h2>Reviews & ratings</h2></div></div><c:if test="${not empty sessionScope.user}"><form class="review-form" action="<c:url value='/reviews'/>" method="post"><input type="hidden" name="productId" value="${product.productId}"><label>Rating<select class="form-select" name="rating" required><option value="">Choose</option><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Fine</option><option value="2">2 - Could be better</option><option value="1">1 - Poor</option></select></label><label>Your review<textarea class="form-control" name="reviewText" maxlength="2000" required></textarea></label><button class="btn btn-dark-pill" type="submit">Submit review</button></form></c:if><div class="review-list"><c:forEach var="review" items="${reviews}"><article class="review-item"><div class="review-heading"><strong><c:out value="${review.userName}"/></strong><shop:rating score="${review.rating}"/><time><c:out value="${review.createdAt}"/></time></div><p><c:out value="${review.reviewText}"/></p></article></c:forEach><c:if test="${empty reviews}"><p class="muted">No reviews yet. Your experience can be the first.</p></c:if></div></section>
<%@ include file="fragments/footer.jsp" %>
