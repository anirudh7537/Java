<%@ include file="fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">ACCOUNT / DELIVERY</span><h1>Your profile</h1></div><div class="content-grid"><%@ include file="fragments/sidebar.jsp" %><div class="admin-main"><section class="form-panel-wide"><h2 class="h5">Profile details</h2><form action="<c:url value='/profile'/>" method="post" class="management-form"><input type="hidden" name="action" value="profile"><label>Name<input class="form-control" name="name" value="<c:out value='${sessionScope.user.name}'/>" maxlength="120" required></label><label>Email<input class="form-control" value="<c:out value='${sessionScope.user.email}'/>" disabled></label><label>Mobile<input class="form-control" name="mobile" value="<c:out value='${sessionScope.user.mobile}'/>" maxlength="32"></label><button class="btn btn-dark-pill" type="submit">Save profile</button></form></section><h2 class="h5 mb-3">Saved addresses</h2><div class="address-grid"><c:forEach var="address" items="${addresses}"><article class="address-card"><span class="eyebrow"><c:out value="${address.addressType}"/></span><p><c:out value="${address.formattedAddress}"/></p><details><summary class="text-link">Edit address</summary><form action="<c:url value='/profile'/>" method="post" class="stack-form mt-3"><input type="hidden" name="action" value="address"><input type="hidden" name="addressId" value="${address.addressId}"><input class="form-control" name="addressLine" value="<c:out value='${address.addressLine}'/>" required><input class="form-control" name="city" value="<c:out value='${address.city}'/>" required><input class="form-control" name="state" value="<c:out value='${address.state}'/>" required><input class="form-control" name="pincode" value="<c:out value='${address.pincode}'/>" required><select class="form-select" name="addressType"><option>HOME</option><option>WORK</option><option>OTHER</option></select><button class="btn btn-outline-pill" type="submit">Update</button></form></details><form action="<c:url value='/profile'/>" method="post"><input type="hidden" name="action" value="deleteAddress"><input type="hidden" name="addressId" value="${address.addressId}"><button class="btn btn-link text-danger px-0" type="submit">Remove</button></form></article></c:forEach></div><section class="form-panel-wide mt-4"><h2 class="h5">Add an address</h2><form action="<c:url value='/profile'/>" method="post" class="management-form"><input type="hidden" name="action" value="address"><label class="wide">Address line<input class="form-control" name="addressLine" maxlength="255" required></label><label>City<input class="form-control" name="city" required></label><label>State<input class="form-control" name="state" required></label><label>Postal code<input class="form-control" name="pincode" required></label><label>Type<select class="form-select" name="addressType"><option>HOME</option><option>WORK</option><option>OTHER</option></select></label><button class="btn btn-dark-pill" type="submit">Save address</button></form></section></div></div></section>
<%@ include file="fragments/footer.jsp" %>
