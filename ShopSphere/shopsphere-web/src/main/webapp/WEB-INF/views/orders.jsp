<%@ include file="fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">YOUR SHOPSPHERE HISTORY</span><h1>Orders</h1></div><c:choose><c:when test="${empty orders}"><div class="empty-state"><h2>No orders yet.</h2><p>Your next useful find is out there.</p><a class="btn btn-dark-pill" href="<c:url value='/products'/>">Explore products</a></div></c:when><c:otherwise><div class="table-responsive"><table class="table data-table"><thead><tr><th>Order</th><th>Placed</th><th>Payment</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#<c:out value="${order.orderId}"/></td><td><c:out value="${order.createdAt}"/></td><td><span class="status-badge"><c:out value="${order.paymentStatus}"/></span></td><td><span class="status-badge"><c:out value="${order.orderStatus}"/></span></td><td><strong><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></strong></td><td><a class="text-link" href="<c:url value='/order'><c:param name='id' value='${order.orderId}'/></c:url>">Details</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
<%@ include file="fragments/footer.jsp" %>
