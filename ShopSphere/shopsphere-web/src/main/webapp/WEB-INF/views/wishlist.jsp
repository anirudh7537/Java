<%@ include file="fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">SAVED FOR LATER</span><h1>Your wishlist</h1></div><c:choose><c:when test="${empty items}"><div class="empty-state"><h2>A little room for inspiration.</h2><p>Save products and they will be waiting here.</p><a class="btn btn-dark-pill" href="<c:url value='/products'/>">Browse products</a></div></c:when><c:otherwise><div class="product-grid"><c:forEach var="item" items="${items}"><shop:productCard product="${item.product}"/><div class="d-none"><form id="remove-${item.productId}" action="<c:url value='/wishlist'/>" method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${item.productId}"></form><form id="move-${item.productId}" action="<c:url value='/wishlist'/>" method="post"><input type="hidden" name="action" value="moveToCart"><input type="hidden" name="productId" value="${item.productId}"></form></div><div class="d-flex gap-2 mb-3"><button class="btn btn-outline-pill btn-sm" form="move-${item.productId}" type="submit">Move to cart</button><button class="btn btn-link text-danger btn-sm" form="remove-${item.productId}" type="submit">Remove</button></div></c:forEach></div></c:otherwise></c:choose></section>
<%@ include file="fragments/footer.jsp" %>
