<%@ include file="../fragments/header.jsp" %>
<%@ taglib prefix="sql" uri="jakarta.tags.sql" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">JSTL / SQL SYLLABUS ONLY</span><h1>JSTL SQL demonstration</h1></div><div class="form-panel-wide"><c:choose><c:when test="${not empty applicationScope['shopsphere.demoDataSource']}"><sql:query var="catalogStats" dataSource="${applicationScope['shopsphere.demoDataSource']}">SELECT COUNT(*) AS product_count FROM products</sql:query><p>Products in the configured ShopSphere database: <strong><c:out value="${catalogStats.rows[0].product_count}"/></strong></p></c:when><c:otherwise><p>Set <code>SHOPSPHERE_DB_USER</code> (and, if needed, <code>SHOPSPHERE_DB_PASSWORD</code>) and apply <code>database/shopsphere.sql</code> to enable this database demonstration.</p></c:otherwise></c:choose><p class="muted">JSTL SQL is intentionally isolated here. Production application pages use Servlet → Service → DAO → JDBC.</p></div></section>
