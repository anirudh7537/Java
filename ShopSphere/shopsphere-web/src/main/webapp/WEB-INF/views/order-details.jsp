<%@ include file="fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">ORDER CONFIRMATION / #<c:out value="${order.orderId}"/></span><h1>Order details</h1></div><a class="text-link" href="<c:url value='/orders'/>">Back to order history</a></div><c:if test="${order.paymentStatus eq 'FAILED'}"><div class="alert alert-warning">Mock payment was declined. No stock was reserved and your cart remains available to retry.</div></c:if><div class="row g-4"><div class="col-lg-8"><div class="table-responsive"><table class="table data-table"><thead><tr><th>Product</th><th>Quantity</th><th>Price</th><th>Line total</th></tr></thead><tbody><c:forEach var="item" items="${order.items}"><tr><td><c:out value="${item.productName}"/></td><td><c:out value="${item.quantity}"/></td><td><fmt:formatNumber value="${item.price}" type="currency" currencyCode="INR"/></td><td><fmt:formatNumber value="${item.lineTotal}" type="currency" currencyCode="INR"/></td></tr></c:forEach></tbody></table></div></div><div class="col-lg-4"><aside class="checkout-summary"><span class="eyebrow">STATUS TRACKING</span><p><span class="status-badge"><c:out value="${order.orderStatus}"/></span></p><div class="summary-line"><span>Placed</span><span><c:out value="${order.createdAt}"/></span></div><div class="summary-line"><span>Payment</span><span><c:out value="${order.paymentStatus}"/></span></div><div class="summary-line"><span>Discount</span><span><fmt:formatNumber value="${order.discount}" type="currency" currencyCode="INR"/></span></div><div class="summary-line summary-total"><span>Total</span><span><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></span></div></aside></div></div></section>
<%@ include file="fragments/footer.jsp" %>
