<%@ include file="fragments/header.jsp" %>
<section class="container catalog-page"><div class="page-title"><span class="eyebrow">SECURE CHECKOUT</span><h1>Almost yours.</h1></div><c:choose><c:when test="${empty items}"><div class="empty-state"><h2>Your cart is empty.</h2><a class="btn btn-dark-pill" href="<c:url value='/products'/>">Browse the collection</a></div></c:when><c:otherwise><form action="<c:url value='/checkout'/>" method="post" class="checkout-layout"><div><section class="checkout-section"><h2>01 / Delivery address</h2><c:choose><c:when test="${empty addresses}"><p>Add a delivery address before checkout.</p><a class="btn btn-outline-pill" href="<c:url value='/profile'/>">Manage addresses</a></c:when><c:otherwise><c:forEach var="address" items="${addresses}" varStatus="loop"><label class="address-option"><input type="radio" name="addressId" value="${address.addressId}" required <c:if test="${loop.first}">checked</c:if>><strong><c:out value="${address.addressType}"/></strong><span class="d-block ms-4"><c:out value="${address.formattedAddress}"/></span></label></c:forEach><a class="text-link" href="<c:url value='/profile'/>">Add or edit an address</a></c:otherwise></c:choose></section><section class="checkout-section"><h2>02 / Coupon</h2><label for="couponCode">Coupon code <span class="muted">(optional)</span></label><input id="couponCode" class="form-control mt-2" name="couponCode" maxlength="50" placeholder="Enter code"></section><section class="checkout-section"><h2>03 / Mock payment</h2><p class="muted">No real payment gateway is connected. Select an outcome for the local payment demonstration.</p><select class="form-select" name="mockResult"><option value="approve">Simulate successful payment</option><option value="decline">Simulate declined payment</option></select></section></div><aside class="checkout-summary"><h2>Order summary</h2><c:forEach var="item" items="${items}"><div class="summary-line"><span><c:out value="${item.product.name}"/> x <c:out value="${item.quantity}"/></span><strong><fmt:formatNumber value="${item.lineTotal}" type="currency" currencyCode="INR"/></strong></div></c:forEach><div class="summary-line"><span>Current subtotal</span><strong><fmt:formatNumber value="${subtotal}" type="currency" currencyCode="INR"/></strong></div><p class="muted">The server recalculates prices, stock, coupon eligibility, and final total during placement.</p><button class="btn btn-dark-pill w-100" type="submit" <c:if test="${empty addresses}">disabled</c:if>>Place order</button></aside></form></c:otherwise></c:choose></section>
<%@ include file="fragments/footer.jsp" %>
